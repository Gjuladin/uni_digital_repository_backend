<?xml version="1.0"?>
<!--
  - local-types.xml
  -
  - An empty registry for instance-specific, local metadata. Any non-standard
  - metadata fields should be added here to avoid polluting the standard
  - namespaces.
  - 
  -->
<dspace-dc-types>

  <dspace-header>
    <title>Registry of instance-specific metadata fields</title>
    <contributor.author>Ivan Mas&#xE1;r</contributor.author>
    <contributor.editor>$Author$</contributor.editor>
    <date.created>$Date$</date.created>
    <description>$Log$</description>
    <description.version>$Revision$</description.version>
  </dspace-header>

  <dc-schema>
    <name>local</name>
    <namespace>http://dspace.org/namespace/local/</namespace>
  </dc-schema>

<!--
  <dc-type>
    <schema>local</schema>
    <element></element>
    <qualifier></qualifier>
    <scope_note>Description of example metadata field.</scope_note>
  </dc-type>
-->

  <!-- UIST research-data descriptions. Never use relation.hasversion (a link to
       another resource) or description.version (SWORD review status) for a version label. -->
  <dc-type>
    <schema>local</schema><element>dataset</element><qualifier>version</qualifier>
    <scope_note>Depositor-supplied dataset release label, independent of DSpace item version history.</scope_note>
  </dc-type>
  <dc-type>
    <schema>local</schema><element>dataset</element><qualifier>methods</qualifier>
    <scope_note>Methods used to create, compile, process and validate the dataset.</scope_note>
  </dc-type>
  <dc-type>
    <schema>local</schema><element>creator</element><qualifier>affiliation</qualifier>
    <scope_note>Creator name and institutional affiliation as a descriptive statement; no implicit creator linkage.</scope_note>
  </dc-type>
</dspace-dc-types>
